{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocore-team.github.io/autohub/data/engines/source/schema.json",
  "title": "AutoHub regional engine source file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "region",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "region": {
      "type": "string",
      "enum": [
        "europe",
        "japan",
        "korea",
        "usa"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engineRecord"
      }
    }
  },
  "$defs": {
    "engineRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "aliases",
        "maker",
        "regionKey",
        "years",
        "displacement",
        "layout",
        "fuelKey",
        "aspirationKey",
        "injectionKey",
        "blockKey",
        "timingKey",
        "applications",
        "consumption",
        "declaredLifeKey",
        "typicalLife",
        "oilRecord",
        "statusKey",
        "text",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "maker": {
          "type": "string",
          "minLength": 1
        },
        "regionKey": {
          "type": "string",
          "enum": [
            "europe",
            "japan",
            "korea",
            "usa"
          ]
        },
        "years": {
          "type": "string",
          "minLength": 1
        },
        "displacement": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "fuelKey": {
          "type": "string",
          "minLength": 1
        },
        "aspirationKey": {
          "type": "string",
          "minLength": 1
        },
        "injectionKey": {
          "type": "string",
          "minLength": 1
        },
        "blockKey": {
          "type": "string",
          "minLength": 1
        },
        "timingKey": {
          "type": "string",
          "minLength": 1
        },
        "applications": {
          "$ref": "#/$defs/stringArray"
        },
        "consumption": {
          "type": "string",
          "minLength": 1
        },
        "declaredLifeKey": {
          "type": "string",
          "minLength": 1
        },
        "typicalLife": {
          "type": "string",
          "minLength": 1
        },
        "oilRecord": {
          "type": "string"
        },
        "statusKey": {
          "type": "string",
          "minLength": 1
        },
        "performance": {
          "$ref": "#/$defs/performance"
        },
        "text": {
          "$ref": "#/$defs/localizedText"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es",
        "fr",
        "de"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/engineText"
        },
        "es": {
          "$ref": "#/$defs/engineText"
        },
        "fr": {
          "$ref": "#/$defs/engineText"
        },
        "de": {
          "$ref": "#/$defs/engineText"
        }
      }
    },
    "engineText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction",
        "issues",
        "pros",
        "cons"
      ],
      "properties": {
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "string",
          "minLength": 1
        },
        "pros": {
          "type": "string",
          "minLength": 1
        },
        "cons": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerKw",
        "torqueNm"
      ],
      "properties": {
        "powerKw": {
          "$ref": "#/$defs/rangeWithRpm"
        },
        "torqueNm": {
          "$ref": "#/$defs/rangeWithRpm"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "rangeWithRpm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "rpm": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "legacyPending"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "publisher",
        "year",
        "url",
        "page",
        "checkedAt",
        "fields"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "manufacturer",
            "technicalReference",
            "serviceDocumentation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pageNotes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
