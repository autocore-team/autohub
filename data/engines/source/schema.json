{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d3orient.com/data/engines/source/schema.json",
  "title": "AutoHub regional engine source file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "region",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "region": {
      "type": "string",
      "enum": [
        "europe",
        "japan",
        "korea",
        "north-america",
        "south-america"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engineRecord"
      }
    }
  },
  "$defs": {
    "engineRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "maker",
        "regionKey",
        "years",
        "displacement",
        "layout",
        "fuelKey",
        "aspirationKey",
        "injectionKey",
        "blockKey",
        "timingKey",
        "applications",
        "consumption",
        "declaredLifeKey",
        "typicalLife",
        "oilRecord",
        "statusKey",
        "text",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/engineIdentity"
        },
        "completeness": {
          "type": "string",
          "enum": ["full", "core"],
          "description": "Optional on existing records. New strict records use full when both performance RPM fields are documented, or core when one or both RPM fields are unavailable."
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "maker": {
          "type": "string",
          "minLength": 1
        },
        "regionKey": {
          "type": "string",
          "enum": [
            "europe",
            "japan",
            "korea",
            "north-america",
            "south-america"
          ]
        },
        "years": {
          "type": "string",
          "minLength": 1
        },
        "displacement": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "fuelKey": {
          "type": "string",
          "minLength": 1
        },
        "aspirationKey": {
          "type": "string",
          "minLength": 1
        },
        "injectionKey": {
          "type": "string",
          "minLength": 1
        },
        "blockKey": {
          "type": "string",
          "minLength": 1
        },
        "timingKey": {
          "type": "string",
          "minLength": 1
        },
        "applications": {
          "$ref": "#/$defs/stringArray"
        },
        "consumption": {
          "type": "string",
          "minLength": 1
        },
        "declaredLifeKey": {
          "type": "string",
          "minLength": 1
        },
        "typicalLife": {
          "type": "string",
          "minLength": 1
        },
        "oilRecord": {
          "type": "string"
        },
        "statusKey": {
          "type": "string",
          "minLength": 1
        },
        "performance": {
          "$ref": "#/$defs/performance"
        },
        "text": {
          "$ref": "#/$defs/localizedText"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["identity"],
            "properties": {
              "identity": {
                "properties": { "type": { "enum": ["officialPublicDesignation", "applicationScopedSpecification"] } },
                "required": ["type"]
              }
            }
          },
          "then": {
            "not": { "required": ["code"] }
          },
          "else": {
            "required": ["code"]
          }
        }
      ]
    },
    "engineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exactCode", "officialPublicDesignation", "applicationScopedSpecification"]
        },
        "value": { "type": "string", "minLength": 1 },
        "review": {
          "oneOf": [
            { "$ref": "#/$defs/officialDesignationReview" },
            { "$ref": "#/$defs/applicationScopedSpecificationReview" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "officialPublicDesignation" } } },
          "then": { "required": ["review"] }
        },
        {
          "if": { "properties": { "type": { "const": "applicationScopedSpecification" } } },
          "then": {
            "required": ["review"],
            "properties": { "review": { "$ref": "#/$defs/applicationScopedSpecificationReview" } }
          }
        }
      ]
    },
    "officialDesignationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialPublicationConfirmed",
        "stableAndDistinct",
        "genericDescriptionRejected",
        "materialVariantsSeparated",
        "notes"
      ],
      "properties": {
        "officialPublicationConfirmed": { "const": true },
        "stableAndDistinct": { "const": true },
        "genericDescriptionRejected": { "const": true },
        "materialVariantsSeparated": { "const": true },
        "notes": { "$ref": "#/$defs/nonEmptyUniqueStringArray" }
      }
    },
    "applicationScopedSpecificationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manualReviewConfirmed",
        "applicationScopeConfirmed",
        "codeOrDesignationNotClaimed",
        "materialVariantsSeparated",
        "cosmeticVariantsConsolidated",
        "notes"
      ],
      "properties": {
        "manualReviewConfirmed": { "const": true },
        "applicationScopeConfirmed": { "const": true },
        "codeOrDesignationNotClaimed": { "const": true },
        "materialVariantsSeparated": { "const": true },
        "cosmeticVariantsConsolidated": { "const": true },
        "notes": { "$ref": "#/$defs/nonEmptyUniqueStringArray" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es",
        "fr",
        "de"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/engineText"
        },
        "es": {
          "$ref": "#/$defs/engineText"
        },
        "fr": {
          "$ref": "#/$defs/engineText"
        },
        "de": {
          "$ref": "#/$defs/engineText"
        }
      }
    },
    "engineText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction",
        "issues",
        "pros",
        "cons"
      ],
      "properties": {
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "string",
          "minLength": 1
        },
        "pros": {
          "type": "string",
          "minLength": 1
        },
        "cons": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerKw",
        "torqueNm"
      ],
      "properties": {
        "powerKw": {
          "$ref": "#/$defs/rangeWithRpm"
        },
        "torqueNm": {
          "$ref": "#/$defs/rangeWithRpm"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "rangeWithRpm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "rpm": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "sourceRefs"
            ]
          },
          "then": {
            "required": [
              "sources",
              "scope"
            ],
            "properties": {
              "sources": {
                "items": {
                  "allOf": [
                    {
                      "required": [
                        "id",
                        "scope"
                      ]
                    },
                    {
                      "oneOf": [
                        {
                          "required": [
                            "identityBindingRef"
                          ],
                          "properties": {
                            "scope": {
                              "allOf": [
                                { "not": { "required": ["codes"] } },
                                { "not": { "required": ["designations"] } }
                              ]
                            }
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "identityBindingRef"
                            ]
                          },
                          "properties": {
                            "scope": {
                              "required": ["codes"],
                              "not": { "required": ["designations"] }
                            }
                          }
                        },
                        {
                          "not": {
                            "required": ["identityBindingRef"]
                          },
                          "properties": {
                            "scope": {
                              "required": ["designations"],
                              "not": { "required": ["codes"] }
                            }
                          }
                        },
                        {
                          "not": {
                            "required": ["identityBindingRef"]
                          },
                          "properties": {
                            "scope": {
                              "allOf": [
                                { "not": { "required": ["codes"] } },
                                { "not": { "required": ["designations"] } }
                              ]
                            },
                            "fields": {
                              "contains": { "const": "identity.applicationScopedSpecification" }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "corroborated",
            "legacyPending"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceBasis": {
          "type": "string",
          "enum": [
            "official",
            "corroborated"
          ],
          "description": "Explicit strict-evidence path for new records. Omitted on compatible legacy records."
        },
        "scope": {
          "$ref": "#/$defs/verificationScope"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "publisher",
        "year",
        "url",
        "page",
        "checkedAt",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identityBindingRef": {
          "type": "string",
          "minLength": 1,
          "description": "For strict supplemental evidence without direct identity coverage, references a validated direct exactVariant identity source in the same verification.sources registry. Mutually exclusive with scope.codes and scope.designations."
        },
        "type": {
          "type": "string",
          "enum": [
            "manufacturer",
            "technicalReference",
            "serviceDocumentation",
            "certificationDocument"
          ]
        },
        "evidenceTier": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ],
          "description": "Trust tier assigned to this specific document and its declared fields, not to the publisher domain as a whole."
        },
        "dataOrigin": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized upstream dataset or editorial origin. Required by policy for Tier B independence checks."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Legal or organizational owner of the publication. Distinct ownership is required for editorial independence when declared."
        },
        "editorialTeam": {
          "type": "string",
          "minLength": 1,
          "description": "Editorial operation responsible for the published specification."
        },
        "contentRelationship": {
          "type": "string",
          "enum": ["originalEditorial", "mirror", "translation", "syndicated"],
          "description": "Relationship of this publication to the paired evidence. Mirrors, translations and syndicated copies are not independent."
        },
        "upstreamDatabase": {
          "type": "string",
          "minLength": 1,
          "description": "Named commercial upstream database, when applicable. Matching values make two publications dependent."
        },
        "independenceNotes": {
          "$ref": "#/$defs/stringArray",
          "description": "Why a Tier B publisher is independent from the other corroborating sources."
        },
        "authorityNotes": {
          "$ref": "#/$defs/stringArray",
          "description": "Editorial, licensing or provenance basis when a professional technical publication is classified as Tier A."
        },
        "claims": {
          "$ref": "#/$defs/sourceClaims",
          "description": "Structured Tier B performance claims used to reject conflicting values."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pageNotes": {
          "$ref": "#/$defs/stringArray"
        },
        "scope": {
          "$ref": "#/$defs/sourceScope"
        }
      }
    },
    "sourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "applications",
        "years",
        "markets"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "exactVariant",
            "family",
            "aggregate"
          ]
        },
        "codes": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray",
          "description": "Exact engine codes explicitly present in the document. Required by the direct-code path and omitted by the designation and identity-bridge paths."
        },
        "designations": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray",
          "description": "Official public engine designations explicitly present in the document. Mutually exclusive with codes and identityBindingRef."
        },
        "applications": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "years": {
          "$ref": "#/$defs/yearScope"
        },
        "markets": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "sourceClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performance.powerKw": {
          "$ref": "#/$defs/rangeWithRpm"
        },
        "performance.torqueNm": {
          "$ref": "#/$defs/rangeWithRpm"
        }
      }
    },
    "verificationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications",
        "years",
        "markets"
      ],
      "properties": {
        "applications": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "years": {
          "$ref": "#/$defs/yearScope"
        },
        "markets": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "yearScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1885
        },
        "to": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1885
            },
            {
              "const": "present"
            }
          ]
        }
      }
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
